generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  FINANCE
  VIEWER
  EMPLOYEE
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum OneTimeCodePurpose {
  PASSWORD_RESET
  PAYROLL_APPROVAL
}

enum PaymentFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum PayrollStatus {
  DRAFT
  PENDING_APPROVAL
  SCHEDULED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  PAYROLL_DEBIT
  REFUND
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum NotificationType {
  PAYROLL_SCHEDULED
  PAYROLL_COMPLETED
  PAYROLL_FAILED
  DEPOSIT_SUCCESS
  LOW_BALANCE
  EMPLOYEE_ADDED
  GENERAL
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum SupportTicketCategory {
  PAYMENT_FAILURE
  WALLET_FUNDING
  BANK_VERIFICATION
  PAYROLL_ISSUE
  ACCOUNT_ACCESS
  GENERAL
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportMessageSender {
  CUSTOMER
  SUPPORT
  SYSTEM
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  password     String?
  firstName    String
  lastName     String
  role         Role         @default(ADMIN)
  authProvider AuthProvider @default(LOCAL)
  googleId     String?      @unique
  companyId    String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  passwordChangedAt DateTime?

  company          Company?         @relation(fields: [companyId], references: [id])
  ownedCompany     Company?         @relation("CompanyOwner")
  notifications    Notification[]
  createdPayrolls  Payroll[]        @relation("PayrollCreatedBy")
  approvedPayrolls Payroll[]        @relation("PayrollApprovedBy")
  auditLogs        AuditLog[]
  supportTickets   SupportTicket[]  @relation("SupportTicketCreatedBy")
  supportMessages  SupportMessage[] @relation("SupportMessageAuthor")
  authSessions     AuthSession[]
  oneTimeCodes     OneTimeCode[]

  @@index([email])
  @@index([companyId])
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  familyId         String
  userAgent        String?
  ipAddress        String?
  deviceName       String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?
  replacedById     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model OneTimeCode {
  id         String            @id @default(uuid())
  userId     String
  purpose    OneTimeCodePurpose
  codeHash   String
  attempts   Int               @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime          @default(now())
  metadata   Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

model Company {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  address   String?
  ownerId   String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner          User            @relation("CompanyOwner", fields: [ownerId], references: [id])
  users          User[]
  wallet         Wallet?
  employees      Employee[]
  payrolls       Payroll[]
  transactions   Transaction[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  supportTickets SupportTicket[]

  @@index([ownerId])
}

model Wallet {
  id              String   @id @default(uuid())
  companyId       String   @unique
  balance         Int      @default(0) // stored in kobo (1 NGN = 100 kobo)
  reservedBalance Int      @default(0)
  currency        String   @default("NGN")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id])
  transactions Transaction[]
}

model Employee {
  id                    String           @id @default(uuid())
  companyId             String
  firstName             String
  lastName              String
  email                 String
  phone                 String?
  bankName              String
  bankCode              String
  accountNumber         String
  accountNumberLast4    String?
  accountName           String
  salary                Int // in kobo
  department            String?
  position              String?
  paymentFrequency      PaymentFrequency @default(MONTHLY)
  nextPaymentDate       DateTime?
  paystackRecipientCode String?
  isActive              Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  company          Company           @relation(fields: [companyId], references: [id])
  payrollEmployees PayrollEmployee[]
  transactions     Transaction[]

  @@unique([companyId, email])
  @@index([companyId])
  @@index([companyId, accountNumberLast4])
}

model Payroll {
  id                    String        @id @default(uuid())
  companyId             String
  createdById           String?
  approvedById          String?
  scheduledDate         DateTime
  processedDate         DateTime?
  submittedAt           DateTime?
  approvedAt            DateTime?
  cancelledAt           DateTime?
  processingStartedAt   DateTime?
  processingHeartbeatAt DateTime?
  reservationReleasedAt DateTime?
  processingAttempt     Int           @default(0)
  failureReason         String?
  status                PayrollStatus @default(DRAFT)
  totalAmount           Int           @default(0) // in kobo
  employeeCount         Int           @default(0)
  note                  String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  company          Company           @relation(fields: [companyId], references: [id])
  createdBy        User?             @relation("PayrollCreatedBy", fields: [createdById], references: [id])
  approvedBy       User?             @relation("PayrollApprovedBy", fields: [approvedById], references: [id])
  payrollEmployees PayrollEmployee[]
  supportTickets   SupportTicket[]

  @@index([companyId])
  @@index([createdById])
  @@index([approvedById])
  @@index([status])
  @@index([scheduledDate])
  @@index([status, processingHeartbeatAt])
}

model PayrollEmployee {
  id         String            @id @default(uuid())
  payrollId  String
  employeeId String
  amount     Int // in kobo
  status     TransactionStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  payroll     Payroll      @relation(fields: [payrollId], references: [id])
  employee    Employee     @relation(fields: [employeeId], references: [id])
  transaction Transaction?

  @@unique([payrollId, employeeId])
  @@index([payrollId])
  @@index([employeeId])
}

model Transaction {
  id                      String            @id @default(uuid())
  companyId               String
  walletId                String
  employeeId              String?
  payrollEmployeeId       String?           @unique
  type                    TransactionType
  amount                  Int // in kobo
  status                  TransactionStatus @default(PENDING)
  description             String?
  paystackReference       String?           @unique
  paystackTransferId      String?           @unique
  reconciliationStartedAt DateTime?
  reconciliationCheckedAt DateTime?
  reconciliationAttempt   Int               @default(0)
  reconciliationError     String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  company         Company          @relation(fields: [companyId], references: [id])
  wallet          Wallet           @relation(fields: [walletId], references: [id])
  employee        Employee?        @relation(fields: [employeeId], references: [id])
  payrollEmployee PayrollEmployee? @relation(fields: [payrollEmployeeId], references: [id])
  supportTickets  SupportTicket[]

  @@index([companyId])
  @@index([walletId])
  @@index([payrollEmployeeId])
  @@index([status])
  @@index([type])
  @@index([type, status, reconciliationCheckedAt])
}

model Notification {
  id        String              @id @default(uuid())
  companyId String
  userId    String
  type      NotificationType    @default(GENERAL)
  channel   NotificationChannel @default(IN_APP)
  title     String
  message   String
  isRead    Boolean             @default(false)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@index([isRead])
}

model AuditLog {
  id         String   @id @default(uuid())
  companyId  String
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
}

model SupportTicket {
  id            String                @id @default(uuid())
  reference     String                @unique
  companyId     String
  createdById   String
  payrollId     String?
  transactionId String?
  category      SupportTicketCategory
  priority      SupportTicketPriority @default(NORMAL)
  status        SupportTicketStatus   @default(OPEN)
  subject       String
  lastMessageAt DateTime              @default(now())
  resolvedAt    DateTime?
  closedAt      DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  company     Company          @relation(fields: [companyId], references: [id])
  createdBy   User             @relation("SupportTicketCreatedBy", fields: [createdById], references: [id])
  payroll     Payroll?         @relation(fields: [payrollId], references: [id])
  transaction Transaction?     @relation(fields: [transactionId], references: [id])
  messages    SupportMessage[]

  @@index([companyId, status])
  @@index([companyId, lastMessageAt])
  @@index([createdById])
  @@index([payrollId])
  @@index([transactionId])
}

model SupportMessage {
  id           String               @id @default(uuid())
  ticketId     String
  authorUserId String?
  senderType   SupportMessageSender @default(CUSTOMER)
  body         String
  isInternal   Boolean              @default(false)
  createdAt    DateTime             @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?         @relation("SupportMessageAuthor", fields: [authorUserId], references: [id])

  @@index([ticketId, createdAt])
  @@index([authorUserId])
}
